 ;EdLin	ENDP
 
+;---------------- Clipboard: client + extension module -----------------
+; The work is done by VCEXT.BIN (third_party/vc/ext/vcext.asm), loaded by ExtLoad
+; at start into a block of ExtBlk paragraphs; without the file nothing happens.
+; Line editing: Ctrl-Ins - copy the line, Shift-Ins - paste, Shift-Del - cut.
+ExtBlk	EQU	100h			; Paragraphs for the module block (4 KB)
+XCopy	EQU	4			; Entries of the module (offsets in the file)
+XFetch	EQU	7
+Buf	EQU	800h			; The text of the clipboard in the block
+
+E14_00:	CALL	ClipShift		; Shift-Ins - paste
+	JE	E00_04
+	CALL	ClipPaste
+	JMP	E00_06
+E15_00:	MOV	BX,XCopy		; Ctrl-Ins - copy
+	CALL	ExtCall
+	JMP	E00_04
+E16_00:	CALL	ClipShift		; Shift-Del - cut, Del - delete a char
+	JE	E08_00
+	MOV	BX,XCopy
+	CALL	ExtCall
+	JC	E08_00			; No clipboard: only delete a char
+	MOV	BYTE PTR ES:[DI],0
+	XOR	DX,DX
+	JMP	E00_06
+F08_S:	CALL	ClipShift		; Shift-Ins - paste to the command line
+	JE	F08_00
+	JMP	F73_00
+
+; Shift pressed?  ZF=0 - yes.  Destroys: flags.
+ClipShift:
+	PUSH	AX
+	MOV	AH,2
+	INT	16h
+	TEST	AL,3
+	POP	AX
+	RET
+
+ExtOff	DW	0			; Far pointer to an entry of the module:
+ExtSeg	DW	0			; offset, segment (0 - no module)
+
+; Call the entry BX of the module.  CF=1 - no module.  The entry's contract applies.
+ExtCall:
+	CMP	CS:[ExtSeg],0
+	JE	EC_09
+	MOV	CS:[ExtOff],BX
+	CALL	DWORD PTR CS:[ExtOff]
+	RET
+EC_09:	STC
+	RET
+
+; Insert the first line of the clipboard text into the line ES:DI at the cursor
+; DX; CX - max length of the line, as for EdLin.  Returns DX.  Destroys: flags.
+ClipPaste:
+	PUSH	AX
+	PUSH	BX
+	PUSH	SI
+	PUSH	BP
+	PUSH	CX
+	PUSH	DX			; Cursor
+	MOV	BX,XFetch
+	CALL	ExtCall			; CX - length of the text
+	MOV	BP,CX
+	POP	DX
+	POP	CX
+	JC	CP_09
+	XOR	BX,BX
+CP_04:	CMP	BX,BP
+	JAE	CP_09
+	PUSH	DS
+	MOV	DS,CS:[ExtSeg]
+	MOV	AL,DS:[BX+Buf]
+	POP	DS
+	INC	BX
+	XOR	AH,AH
+	PUSH	BX
+	MOV	SI,DI
+	CALL	EdLin
+	POP	BX
+	JC	CP_04
+CP_09:	POP	BP
+	POP	SI
+	POP	BX
+	POP	AX
+	RET
+
+ExtName	DB	'VCEXT.BIN',0
+
+; Load VCEXT.BIN from the directory of VC.COM.  In: ES:DI - the path of VC.COM in
+; the environment.  Destroys: AX, BX, CX, DX, SI (not live in Init28, G5), flags.
+; On any error there is no module (ExtSeg=0).
+ExtLoad:
+	PUSH	DI
+	PUSH	DS
+	PUSH	ES
+	CLD
+	MOV	CS:[ExtSeg],0
+	MOV	BX,ExtBlk
+	MOV	AH,48h
+	INT	21h
+	JC	EL_09
+	PUSH	ES
+	POP	DS
+	MOV	SI,DI
+	MOV	ES,AX
+	MOV	DI,0C00h		; The path: up to the last '\', then the name
+	XOR	BX,BX
+EL_01:	LODSB
+	STOSB
+	CMP	AL,'\'
+	JNE	EL_02
+	MOV	BX,DI
+EL_02:	OR	AL,AL
+	JNE	EL_01
+	OR	BX,BX
+	JE	EL_08
+	MOV	DI,BX
+	MOV	SI,OFFSET ExtName
+	PUSH	CS
+	POP	DS
+	MOV	CX,10
+	REP	MOVSB
+	PUSH	ES
+	POP	DS
+	MOV	DX,0C00h
+	MOV	AX,3D00h
+	INT	21h
+	JC	EL_08
+	XCHG	BX,AX
+	XOR	DX,DX
+	MOV	CX,800h
+	MOV	AH,3Fh
+	INT	21h
+	PUSHF
+	MOV	AH,3Eh
+	INT	21h
+	POPF
+	JC	EL_08
+	CMP	WORD PTR DS:[0],'CV'	; 'VCX1'
+	JNE	EL_08
+	CMP	WORD PTR DS:[2],'1X'
+	JNE	EL_08
+	MOV	CS:[ExtSeg],DS
+	JMP	EL_09
+EL_08:	MOV	AH,49h
+	INT	21h
+EL_09:	POP	ES
+	POP	DS
+	POP	DI
+	RET
+
 EdSub1	PROC	NEAR
 	ADD	DI,DX
 	MOV	SI,DI
